# Copy this file to .env and adjust values as needed.
# NEVER commit the real .env file (it's in .gitignore).

# --- PostgreSQL (single instance, two databases) ---
POSTGRES_USER=dsp_user
POSTGRES_PASSWORD=dsp_password
POSTGRES_DB=dsp_db
AIRFLOW_DB=airflow_db

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Any long random string - must be the same across airflow-apiserver,
# airflow-scheduler, airflow-dag-processor and airflow-triggerer (it is,
# since they all read this same .env file).
AIRFLOW_JWT_SECRET=please_change_this_jwt_secret

# --- Microsoft Teams webhooks (optional - alerts are skipped if unset) ---
TEAMS_WEBHOOK_DATA_QUALITY=
TEAMS_WEBHOOK_ML_ALERTS=
